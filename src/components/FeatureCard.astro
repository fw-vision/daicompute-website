---
/**
 * A generic feature / audience card. Field-label kicker + title + body + CTA.
 */
export interface Props {
  kicker?: string;
  title: string;
  href?: string;
  cta?: string;
  accent?: "orange" | "yellow" | "red";
}
const { kicker, title, href, cta, accent = "orange" } = Astro.props;
const accentVar =
  accent === "yellow" ? "var(--color-yellow)" : accent === "red" ? "var(--color-flag-red)" : "var(--color-orange)";
---

<div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-7">
  {kicker && <span class="field-label" style={`color: ${accentVar};`}>{kicker}</span>}
  <h3 class:list={["font-display text-xl font-semibold leading-snug text-snow", kicker && "mt-3"]}>{title}</h3>
  <div class="mt-3 grow text-sm leading-relaxed text-slate"><slot /></div>
  {
    href && cta && (
      <a href={href} class="accent-link field-note mt-5 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
        {cta}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</div>
