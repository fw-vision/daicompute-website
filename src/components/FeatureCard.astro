---
/**
 * A generic feature / audience card. Field-label kicker + title + body, with an
 * optional CTA link. Used for the three faces of the hero (operator, investor,
 * enterprise) and for problem/approach panels.
 */
export interface Props {
  kicker?: string;
  title: string;
  href?: string;
  cta?: string;
  dark?: boolean;
}
const { kicker, title, href, cta, dark = false } = Astro.props;
---

<div
  class:list={[
    "card-lift flex flex-col border p-7",
    dark ? "border-white/15 bg-slate-2/60" : "border-hairline bg-parchment-2/40",
  ]}
>
  {kicker && (
    <span class="field-label" style={`color: ${dark ? "var(--color-spruce-bright)" : "var(--color-spruce)"};`}>
      {kicker}
    </span>
  )}
  <h3 class:list={["font-display text-xl font-semibold leading-snug", kicker && "mt-3"]}>{title}</h3>
  <div class:list={["mt-3 grow text-sm leading-relaxed", dark ? "text-white/70" : "text-graphite"]}>
    <slot />
  </div>
  {
    href && cta && (
      <a href={href} class="accent-link field-note mt-5 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
        {cta}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</div>
