---
/**
 * A numbered plan step (the SB7 three-step plan idiom). Mono step index +
 * title + body. Used on the home and participate pages.
 */
export interface Props {
  index: string; // "01", "02", "03"
  title: string;
  dark?: boolean;
}
const { index, title, dark = false } = Astro.props;
---

<div
  class:list={[
    "card-lift flex flex-col border p-7",
    dark ? "border-white/15 bg-slate-2/60" : "border-hairline bg-parchment-2/50",
  ]}
>
  <span class="field-label" style={`color: ${dark ? "var(--color-spruce-bright)" : "var(--color-spruce)"};`}>
    Step {index}
  </span>
  <h3 class="mt-3 font-display text-xl font-semibold leading-snug">{title}</h3>
  <div class:list={["mt-3 text-sm leading-relaxed", dark ? "text-white/70" : "text-graphite"]}>
    <slot />
  </div>
</div>
