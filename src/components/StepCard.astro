---
/**
 * A numbered plan step (SB7 three-step plan). Mono step index + title + body.
 */
export interface Props {
  index: string; // "01" ...
  title: string;
}
const { index, title } = Astro.props;
---

<div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-7">
  <span class="field-label" style="color: var(--color-orange);">Step {index}</span>
  <h3 class="mt-3 font-display text-xl font-semibold leading-snug text-snow">{title}</h3>
  <div class="mt-3 text-sm leading-relaxed text-slate"><slot /></div>
</div>
