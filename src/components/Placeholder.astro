---
/**
 * A labelled placeholder frame in the institutional-grid idiom. Makes a
 * content / image / dataviz gap VISIBLE and plannable. The note field encodes
 * the sourcing brief (often a Cursor / visual-tooling handoff).
 *
 * kind="image" -> image to source
 * kind="video" -> video / loop
 * kind="copy"  -> copy to write
 * kind="data"  -> chart / diagram / map / animated dataviz
 */
export interface Props {
  kind?: "image" | "video" | "copy" | "data";
  label: string;
  note?: string;
  ratio?: string;
}
const { kind = "image", label, note, ratio = "16/9" } = Astro.props;

const kindLabel = {
  image: "Image needed",
  video: "Video needed",
  copy: "Copy needed",
  data: "Data / dataviz needed",
}[kind];
---

<div
  class="tech-grid flex flex-col items-center justify-center border border-dashed border-hairline bg-ink-2/50 p-6 text-center"
  style={`aspect-ratio: ${ratio};`}
  data-placeholder={kind}
>
  <span class="field-label" style="color: var(--color-orange);">{kindLabel}</span>
  <span class="mt-3 max-w-md font-display text-base font-medium leading-snug text-mist">
    {label}
  </span>
  {note && <span class="field-note mt-2 max-w-lg leading-relaxed text-slate/70">{note}</span>}
</div>
