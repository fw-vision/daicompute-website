---
/**
 * PlatformOfAggregators - animated platform-of-aggregators topology.
 *
 * Qualifying energy+compute aggregators integrate into the DAI Compute
 * platform (managed capacity, micro-lending, synthetic-dollar settlement).
 * GridDemo / MarketFlywheel idiom: dashed flow strokes, colour language,
 * freezes under prefers-reduced-motion.
 */
---

<div class="border border-hairline bg-ink-2/40">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline px-6 py-4">
    <p class="field-label text-slate">Demonstration &middot; Platform of aggregators</p>
    <p class="field-note text-slate/70">Standard-setter &middot; integrator</p>
  </div>

  <div class="tech-grid relative">
    <svg
      viewBox="0 0 960 460"
      class="h-auto w-full"
      role="img"
      aria-label="Qualifying aggregators integrate into the DAI Compute platform alongside managed capacity, micro-lending, and settlement"
    >
      <!-- Colour-language legend -->
      <g font-family="monospace" font-size="9">
        <circle cx="34" cy="28" r="5" fill="#d52b1e" />
        <text x="44" y="31" fill="#8a939c">SOVEREIGNTY</text>
        <circle cx="148" cy="28" r="5" fill="#ffc21a" />
        <text x="158" y="31" fill="#8a939c">ENERGY</text>
        <circle cx="238" cy="28" r="5" fill="#ff6a1a" />
        <text x="248" y="31" fill="#8a939c">COMPUTE</text>
      </g>

      <!-- Platform envelope -->
      <rect
        x="380"
        y="70"
        width="520"
        height="340"
        rx="4"
        fill="#14171a"
        fill-opacity="0.55"
        stroke="#d52b1e"
        stroke-width="1.5"
        stroke-opacity="0.85"
      />
      <text
        x="640"
        y="98"
        text-anchor="middle"
        fill="#f4f6f8"
        font-family="monospace"
        font-size="12"
        font-weight="500"
      >DAI COMPUTE PLATFORM</text>
      <text
        x="640"
        y="116"
        text-anchor="middle"
        fill="#8a939c"
        font-family="monospace"
        font-size="9"
      >standard-setter &middot; sovereign pool</text>

      <!-- Flows: aggregators -> platform (under nodes) -->
      <path
        class="poa-flow"
        d="M 168 150 C 260 150, 320 180, 380 210"
        fill="none"
        stroke="#ff6a1a"
        stroke-width="2"
        stroke-opacity="0.75"
      />
      <path
        class="poa-flow poa-flow-slow"
        d="M 168 240 C 250 240, 320 230, 380 230"
        fill="none"
        stroke="#ffc21a"
        stroke-width="2"
        stroke-opacity="0.7"
      />
      <path
        class="poa-flow"
        d="M 168 330 C 260 330, 320 280, 380 250"
        fill="none"
        stroke="#ff6a1a"
        stroke-width="1.8"
        stroke-opacity="0.65"
      />

      <!-- Internal platform links (capacity composition) -->
      <path
        class="poa-flow poa-flow-slow"
        d="M 500 210 C 560 180, 600 170, 640 170"
        fill="none"
        stroke="#d52b1e"
        stroke-width="1.4"
        stroke-opacity="0.45"
      />
      <path
        class="poa-flow"
        d="M 500 230 C 560 250, 600 270, 640 280"
        fill="none"
        stroke="#d52b1e"
        stroke-width="1.4"
        stroke-opacity="0.45"
      />
      <path
        class="poa-flow poa-flow-slow"
        d="M 500 250 C 560 300, 600 340, 640 350"
        fill="none"
        stroke="#d52b1e"
        stroke-width="1.4"
        stroke-opacity="0.45"
      />

      <g font-family="monospace">
        <!-- Qualifying aggregators (left) -->
        <g transform="translate(110,150)">
          <circle class="charge-pulse" r="28" fill="#14171a" stroke="#ff6a1a" stroke-width="1.8" />
          <text y="-4" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="9" font-weight="500">AGG A</text>
          <text y="10" text-anchor="middle" dominant-baseline="central" fill="#ff6a1a" font-size="8">E+C</text>
          <text y="48" text-anchor="middle" fill="#8a939c" font-size="8">qualifying</text>
        </g>
        <g transform="translate(110,240)">
          <circle class="charge-pulse" r="28" fill="#14171a" stroke="#ffc21a" stroke-width="1.8" />
          <text y="-4" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="9" font-weight="500">AGG B</text>
          <text y="10" text-anchor="middle" dominant-baseline="central" fill="#ffc21a" font-size="8">E+C</text>
          <text y="48" text-anchor="middle" fill="#8a939c" font-size="8">qualifying</text>
        </g>
        <g transform="translate(110,330)">
          <circle class="charge-pulse" r="28" fill="#14171a" stroke="#8a939c" stroke-width="1.5" />
          <text y="-4" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="9" font-weight="500">AGG N</text>
          <text y="10" text-anchor="middle" dominant-baseline="central" fill="#8a939c" font-size="8">E+C</text>
          <text y="48" text-anchor="middle" fill="#8a939c" font-size="8">qualifying</text>
        </g>

        <!-- Integration gateway on platform edge -->
        <g transform="translate(450,230)">
          <rect x="-48" y="-22" width="96" height="44" rx="2" fill="#0b0d0f" stroke="#d52b1e" stroke-width="1.5" />
          <text y="-4" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="9" font-weight="500">INTEGRATE</text>
          <text y="12" text-anchor="middle" dominant-baseline="central" fill="#d52b1e" font-size="8">standard I/F</text>
        </g>

        <!-- Platform capabilities -->
        <g transform="translate(720,170)">
          <rect class="charge-pulse" x="-70" y="-20" width="140" height="40" rx="2" fill="#14171a" stroke="#ff6a1a" stroke-width="1.5" />
          <text y="1" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="10" font-weight="500">MANAGED CAPACITY</text>
        </g>
        <g transform="translate(720,280)">
          <rect class="charge-pulse" x="-70" y="-20" width="140" height="40" rx="2" fill="#14171a" stroke="#ffc21a" stroke-width="1.5" />
          <text y="1" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="10" font-weight="500">MICRO-LENDING</text>
        </g>
        <g transform="translate(720,350)">
          <rect class="charge-pulse" x="-70" y="-20" width="140" height="40" rx="2" fill="#14171a" stroke="#d52b1e" stroke-width="1.5" />
          <text y="-4" text-anchor="middle" dominant-baseline="central" fill="#f4f6f8" font-size="9" font-weight="500">SETTLEMENT</text>
          <text y="12" text-anchor="middle" dominant-baseline="central" fill="#d52b1e" font-size="8">CADS</text>
        </g>
      </g>
    </svg>

    <div class="border-t border-hairline px-6 py-4">
      <p class="field-note text-slate">
        Qualifying aggregators plug into one platform. DAI Compute runs managed capacity, micro-lending, and synthetic-dollar settlement, and sets the standard those networks must meet.
      </p>
    </div>
  </div>
</div>

<style>
  .poa-flow {
    stroke-dasharray: 5 9;
    animation: poa-flow-move 1.6s linear infinite;
  }
  .poa-flow-slow {
    animation-duration: 2.4s;
  }
  @keyframes poa-flow-move {
    to {
      stroke-dashoffset: -28;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .poa-flow,
    .poa-flow-slow {
      animation: none;
    }
  }
</style>
