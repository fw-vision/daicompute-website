---
/**
 * Stat row, institutional metrics. Big mono/display figure in a
 * warm accent + label + optional source. Use ONLY verified figures (national
 * data), NOT live protocol metrics (APR/TVL) while pre-launch.
 * See docs/brand/DESIGN.md section 7.
 */
export interface Props {
  stats: Array<{ value: string; label: string; source?: string }>;
  cols?: 2 | 3 | 4;
  accent?: "orange" | "yellow";
}
const { stats, cols = 4, accent = "orange" } = Astro.props;
const colClass = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 md:grid-cols-4",
}[cols];
const accentVar = accent === "yellow" ? "var(--color-yellow)" : "var(--color-orange)";
---

<div class:list={["grid gap-8", colClass]}>
  {
    stats.map((s) => (
      <div>
        <div class="font-display text-4xl font-semibold tracking-tight sm:text-5xl" style={`color: ${accentVar};`}>
          {s.value}
        </div>
        <div class="mt-2 text-sm font-medium text-mist">{s.label}</div>
        {s.source && <div class="field-note mt-1 text-slate/50">{s.source}</div>}
      </div>
    ))
  }
</div>
