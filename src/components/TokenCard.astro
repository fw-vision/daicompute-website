---
/**
 * A token specification card (CADS / sCADS / CROWN). Spec-sheet register:
 * mono ticker + name + tagline + attribute table. See docs/brand/DESIGN.md.
 */
export interface Props {
  symbol: string; // "CADS" | "sCADS" | "CROWN"
  name: string;
  tagline: string;
  attributes: Array<{ k: string; v: string }>;
  accent?: "orange" | "yellow" | "red";
}
const { symbol, name, tagline, attributes, accent = "orange" } = Astro.props;
const accentVar =
  accent === "yellow" ? "var(--color-yellow)" : accent === "red" ? "var(--color-flag-red)" : "var(--color-orange)";
---

<div class="flex flex-col border border-hairline bg-ink-2/70 p-8">
  <div class="flex items-baseline gap-3">
    <span class="ticker font-display text-3xl font-semibold tracking-tight" style={`color: ${accentVar};`}>
      {symbol}
    </span>
    <span class="field-label text-slate">{name}</span>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-mist">{tagline}</p>
  <dl class="mt-6 flex flex-col gap-0">
    {
      attributes.map((a, i) => (
        <div class:list={["flex justify-between gap-6 py-2.5 text-sm", i > 0 && "border-t border-hairline"]}>
          <dt class="field-note shrink-0 text-slate/70">{a.k}</dt>
          <dd class="text-right text-snow">{a.v}</dd>
        </div>
      ))
    }
  </dl>
</div>
