---
/**
 * GridDemo - the signature "centralised vs distributed sovereign compute"
 * demonstration (schematic, in-repo version).
 *
 * Auto-cycles between the two states on a timer with a cross-fade, so it reads
 * as a live, dynamic visual without interaction. Manual buttons pause the
 * auto-cycle. The distributed state shows a real network: many nodes with
 * size/intensity variation, a faint node-to-node mesh, flowing energy
 * particles (yellow = energy in, orange = compute out), a rotating live
 * telemetry HUD card, and a contrast metric strip.
 *
 * The ambitious geographic choropleth version is a Cursor handoff
 * (docs/plans + landscape/canada-energy-compute-data-report.md). This
 * schematic conveys the argument now. Honours prefers-reduced-motion.
 */
---

<div class="border border-hairline bg-ink-2/40">
  <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline px-6 py-4">
    <p class="field-label text-slate">Demonstration &middot; Compute topology</p>
    <div class="inline-flex overflow-hidden rounded-none border border-hairline text-xs" role="group" aria-label="Toggle topology">
      <button type="button" data-mode-btn="centralised" class="mode-btn relative px-4 py-2 font-mono uppercase tracking-[0.12em] transition-colors">
        <span class="relative z-10">Centralised</span>
        <span class="mode-progress" aria-hidden="true"></span>
      </button>
      <button type="button" data-mode-btn="distributed" class="mode-btn relative px-4 py-2 font-mono uppercase tracking-[0.12em] transition-colors">
        <span class="relative z-10">Distributed</span>
        <span class="mode-progress" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="tech-grid relative">
    <svg id="grid-demo-svg" viewBox="0 0 800 440" class="h-auto w-full" role="img" aria-label="Schematic comparing centralised versus distributed Canadian sovereign compute">
      <defs>
        <linearGradient id="gd-energy" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#ffc21a" />
          <stop offset="100%" stop-color="#ff6a1a" />
        </linearGradient>
        <radialGradient id="gd-node-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#ff8340" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#ff6a1a" stop-opacity="0" />
        </radialGradient>
      </defs>

      <!-- Sovereign border frame (flag red) -->
      <rect x="16" y="16" width="768" height="408" fill="none" stroke="#d52b1e" stroke-width="1.5" stroke-opacity="0.5" />
      <text x="28" y="38" fill="#8a939c" font-family="monospace" font-size="11" letter-spacing="2">CANADIAN JURISDICTION</text>

      <!-- Energy sources (left column) -->
      <g id="gd-sources">
        <g transform="translate(66,130)">
          <circle r="15" fill="#14171a" stroke="#ffc21a" stroke-width="1.5" />
          <text y="0" text-anchor="middle" dominant-baseline="central" fill="#ffc21a" font-family="monospace" font-size="12">&#9788;</text>
          <text y="32" text-anchor="middle" fill="#8a939c" font-family="monospace" font-size="9">SOLAR</text>
        </g>
        <g transform="translate(66,220)">
          <circle r="15" fill="#14171a" stroke="#ffc21a" stroke-width="1.5" />
          <text y="1" text-anchor="middle" dominant-baseline="central" fill="#ffc21a" font-family="monospace" font-size="12">&#8767;</text>
          <text y="32" text-anchor="middle" fill="#8a939c" font-family="monospace" font-size="9">HYDRO</text>
        </g>
        <g transform="translate(66,310)">
          <circle r="15" fill="#14171a" stroke="#ffc21a" stroke-width="1.5" />
          <text y="1" text-anchor="middle" dominant-baseline="central" fill="#ffc21a" font-family="monospace" font-size="11">&#9883;</text>
          <text y="32" text-anchor="middle" fill="#8a939c" font-family="monospace" font-size="9">SMR</text>
        </g>
      </g>

      <!-- ============ CENTRALISED STATE ============ -->
      <g id="gd-central" class="gd-state">
        <path class="gd-flow" d="M 82 130 L 400 220" stroke="url(#gd-energy)" stroke-width="2" fill="none" stroke-opacity="0.7" />
        <path class="gd-flow" d="M 82 220 L 400 220" stroke="url(#gd-energy)" stroke-width="2" fill="none" stroke-opacity="0.7" />
        <path class="gd-flow" d="M 82 310 L 400 220" stroke="url(#gd-energy)" stroke-width="2" fill="none" stroke-opacity="0.7" />
        <circle cx="400" cy="220" r="52" fill="url(#gd-node-glow)" />
        <circle class="charge-pulse" cx="400" cy="220" r="46" fill="#ff6a1a" fill-opacity="0.1" stroke="#ff6a1a" stroke-width="2" />
        <text x="400" y="214" text-anchor="middle" fill="#ff8340" font-family="monospace" font-size="13" font-weight="500">1 SITE</text>
        <text x="400" y="230" text-anchor="middle" fill="#8a939c" font-family="monospace" font-size="9">SUPERCOMPUTER</text>
        <!-- the unserved rest -->
        <g fill="#2a2f35">
          <circle cx="560" cy="140" r="5" /><circle cx="640" cy="180" r="5" /><circle cx="600" cy="260" r="5" />
          <circle cx="680" cy="300" r="5" /><circle cx="520" cy="330" r="5" /><circle cx="690" cy="120" r="5" />
        </g>
        <text x="600" y="380" text-anchor="middle" fill="#525252" font-family="monospace" font-size="9">INDUSTRY &amp; CITIZENS UNSERVED &middot; FOREIGN CLOUD</text>
      </g>

      <!-- ============ DISTRIBUTED STATE ============ -->
      <g id="gd-distributed" class="gd-state">
        <!-- source -> node energy flows (yellow) -->
        <g fill="none" stroke="url(#gd-energy)" stroke-width="1.5" stroke-opacity="0.6">
          <path class="gd-flow" d="M 82 130 L 300 96" />
          <path class="gd-flow" d="M 82 130 L 440 140" />
          <path class="gd-flow" d="M 82 220 L 360 220" />
          <path class="gd-flow" d="M 82 220 L 560 190" />
          <path class="gd-flow" d="M 82 310 L 330 340" />
          <path class="gd-flow" d="M 82 310 L 620 330" />
        </g>
        <!-- node-to-node mesh (faint, shows it is a network) -->
        <g fill="none" stroke="#ff6a1a" stroke-width="1" stroke-opacity="0.28">
          <path class="gd-flow gd-mesh" d="M 300 96 L 440 140" />
          <path class="gd-flow gd-mesh" d="M 440 140 L 560 190" />
          <path class="gd-flow gd-mesh" d="M 360 220 L 560 190" />
          <path class="gd-flow gd-mesh" d="M 360 220 L 330 340" />
          <path class="gd-flow gd-mesh" d="M 560 190 L 620 330" />
          <path class="gd-flow gd-mesh" d="M 440 140 L 690 210" />
          <path class="gd-flow gd-mesh" d="M 620 330 L 690 210" />
          <path class="gd-flow gd-mesh" d="M 300 96 L 360 220" />
        </g>
        <!-- nodes: large = community/energy sites, small = homes -->
        <g>
          <!-- large nodes -->
          <circle class="gd-node gd-node-lg charge-pulse" cx="440" cy="140" r="11" />
          <circle class="gd-node gd-node-lg charge-pulse" cx="560" cy="190" r="11" />
          <circle class="gd-node gd-node-lg charge-pulse" cx="620" cy="330" r="10" />
          <!-- medium nodes -->
          <circle class="gd-node gd-node-md charge-pulse" cx="300" cy="96" r="7" />
          <circle class="gd-node gd-node-md charge-pulse" cx="360" cy="220" r="7" />
          <circle class="gd-node gd-node-md charge-pulse" cx="690" cy="210" r="7" />
          <circle class="gd-node gd-node-md charge-pulse" cx="330" cy="340" r="7" />
          <!-- small home nodes -->
          <g class="gd-node gd-node-sm">
            <circle cx="390" cy="110" r="4" /><circle cx="500" cy="150" r="4" /><circle cx="520" cy="250" r="4" />
            <circle cx="600" cy="250" r="4" /><circle cx="410" cy="300" r="4" /><circle cx="470" cy="340" r="4" />
            <circle cx="660" cy="280" r="4" /><circle cx="280" cy="180" r="4" /><circle cx="670" cy="150" r="4" />
            <circle cx="380" cy="250" r="4" />
          </g>
        </g>
        <text x="490" y="392" text-anchor="middle" fill="#8a939c" font-family="monospace" font-size="9">NODES COAST TO COAST &middot; OWNED BY CANADIANS</text>
      </g>

      <!-- Live telemetry HUD (distributed only) -->
      <g id="gd-hud" transform="translate(596,54)">
        <rect x="0" y="0" width="188" height="52" fill="#0b0d0f" fill-opacity="0.82" stroke="#2a2f35" stroke-width="1" />
        <text x="10" y="18" fill="#ffc21a" font-family="monospace" font-size="9" letter-spacing="1">LIVE &middot; ILLUSTRATIVE</text>
        <text id="gd-hud-line" x="10" y="35" fill="#c4cbd2" font-family="monospace" font-size="10">Node QC-142</text>
        <text id="gd-hud-sub" x="10" y="47" fill="#8a939c" font-family="monospace" font-size="9">4.2 kW solar &middot; 82% util.</text>
      </g>
    </svg>

    <!-- Contrast metric strip -->
    <div class="grid grid-cols-3 border-t border-hairline text-center">
      <div class="border-r border-hairline px-4 py-3">
        <div id="gd-metric-1-v" class="font-display text-xl font-semibold text-snow">1</div>
        <div id="gd-metric-1-l" class="field-note mt-1 text-slate/70">site</div>
      </div>
      <div class="border-r border-hairline px-4 py-3">
        <div id="gd-metric-2-v" class="font-display text-xl font-semibold" style="color: var(--color-orange);">academic</div>
        <div id="gd-metric-2-l" class="field-note mt-1 text-slate/70">who it serves</div>
      </div>
      <div class="px-4 py-3">
        <div id="gd-metric-3-v" class="font-display text-xl font-semibold text-snow">foreign</div>
        <div id="gd-metric-3-l" class="field-note mt-1 text-slate/70">ownership of the rest</div>
      </div>
    </div>

    <div class="border-t border-hairline px-6 py-4">
      <p id="grid-demo-caption" class="field-note text-slate">
        Centralised: one federal supercomputer serves academic research. Industry, startups, and citizens fall back on foreign cloud.
      </p>
    </div>
  </div>
</div>

<style>
  .mode-btn { color: var(--color-slate); background: transparent; }
  .mode-btn[aria-pressed="true"] { color: var(--color-ink); background: var(--color-orange); }
  .mode-btn[aria-pressed="true"] .mode-progress { display: none; }
  /* thin timer bar under the active auto-cycle target */
  .mode-progress {
    position: absolute; left: 0; bottom: 0; height: 2px; width: 0%;
    background: var(--color-yellow);
  }
  .mode-btn.is-arming .mode-progress { width: 100%; transition: width var(--gd-cycle, 5000ms) linear; }

  /* State cross-fade */
  .gd-state { opacity: 0; transition: opacity 0.6s ease; }
  .gd-state.is-active { opacity: 1; }

  /* Node styling */
  .gd-node-lg { fill: #ff6a1a; }
  .gd-node-md { fill: #ff8340; }
  .gd-node-sm circle { fill: #ffc21a; fill-opacity: 0.85; }

  /* Flowing energy along paths */
  .gd-flow { stroke-dasharray: 5 9; animation: gd-flow-move 1.4s linear infinite; }
  .gd-mesh { animation-duration: 2.4s; }
  @keyframes gd-flow-move { to { stroke-dashoffset: -28; } }

  /* HUD hidden by default; shown in distributed */
  #gd-hud { opacity: 0; transition: opacity 0.6s ease; }
  #gd-hud.is-shown { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .gd-flow, .gd-mesh { animation: none; }
    .mode-btn.is-arming .mode-progress { transition: none; width: 0%; }
    .gd-state { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    const svg = document.getElementById("grid-demo-svg");
    if (!svg) return;
    const caption = document.getElementById("grid-demo-caption");
    const hud = document.getElementById("gd-hud");
    const hudLine = document.getElementById("gd-hud-line");
    const hudSub = document.getElementById("gd-hud-sub");
    const btns = Array.from(document.querySelectorAll("[data-mode-btn]"));
    const central = document.getElementById("gd-central");
    const distributed = document.getElementById("gd-distributed");
    const CYCLE = 5000;

    const captions = {
      centralised: "Centralised: one federal supercomputer serves academic research. Industry, startups, and citizens fall back on foreign cloud.",
      distributed: "Distributed: DAI Compute lights up nodes coast to coast, powered by Canadian energy, owned by Canadians.",
    };
    const metrics = {
      centralised: { m1: ["1", "site"], m2: ["academic", "who it serves"], m3: ["foreign", "ownership of the rest"] },
      distributed: { m1: ["N", "nodes"], m2: ["everyone", "who it serves"], m3: ["Canadian", "ownership"] },
    };
    // Illustrative telemetry readouts (labelled illustrative in the HUD).
    const telemetry = [
      ["Node QC-142", "4.2 kW solar \u00b7 82% util."],
      ["Node AB-071", "6.1 kW solar \u00b7 74% util."],
      ["Node BC-238", "hydro-fed \u00b7 ttfb 41ms"],
      ["Node MB-019", "3.8 kW solar \u00b7 88% util."],
      ["Node ON-556", "battery 71% \u00b7 91% util."],
    ];

    const set = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
    function applyMetrics(mode) {
      const m = metrics[mode];
      set("gd-metric-1-v", m.m1[0]); set("gd-metric-1-l", m.m1[1]);
      set("gd-metric-2-v", m.m2[0]); set("gd-metric-2-l", m.m2[1]);
      set("gd-metric-3-v", m.m3[0]); set("gd-metric-3-l", m.m3[1]);
    }

    let mode = "centralised";
    let paused = false;
    let timer = null;
    let hudTimer = null;
    let hudIdx = 0;

    function render(next) {
      mode = next;
      central.classList.toggle("is-active", mode === "centralised");
      distributed.classList.toggle("is-active", mode === "distributed");
      hud.classList.toggle("is-shown", mode === "distributed");
      btns.forEach((b) => b.setAttribute("aria-pressed", b.getAttribute("data-mode-btn") === mode ? "true" : "false"));
      if (caption) caption.textContent = captions[mode];
      applyMetrics(mode);
    }

    function armProgress() {
      // reset then arm the timer bar on the *next* target button
      const nextMode = mode === "centralised" ? "distributed" : "centralised";
      btns.forEach((b) => {
        b.classList.remove("is-arming");
        void b.offsetWidth; // reflow to restart transition
        if (b.getAttribute("data-mode-btn") === nextMode) {
          b.style.setProperty("--gd-cycle", CYCLE + "ms");
          b.classList.add("is-arming");
        }
      });
    }

    function tick() {
      render(mode === "centralised" ? "distributed" : "centralised");
      armProgress();
    }

    function startCycle() {
      if (paused) return;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) { render("distributed"); return; } // static, stronger frame
      armProgress();
      timer = setInterval(tick, CYCLE);
      hudTimer = setInterval(() => {
        if (mode !== "distributed") return;
        hudIdx = (hudIdx + 1) % telemetry.length;
        if (hudLine) hudLine.textContent = telemetry[hudIdx][0];
        if (hudSub) hudSub.textContent = telemetry[hudIdx][1];
      }, 2500);
    }
    function stopCycle() {
      if (timer) clearInterval(timer);
      if (hudTimer) clearInterval(hudTimer);
      timer = null; hudTimer = null;
      btns.forEach((b) => b.classList.remove("is-arming"));
    }

    btns.forEach((b) => b.addEventListener("click", () => {
      paused = true;
      stopCycle();
      render(b.getAttribute("data-mode-btn"));
    }));

    render("centralised");
    startCycle();
  })();
</script>
