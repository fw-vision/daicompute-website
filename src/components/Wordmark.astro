---
/**
 * DAI Compute wordmark. "DAI" in the energetic orange accent, "Compute" in
 * snow. Space Grotesk, tight tracking. See docs/brand/DESIGN.md.
 *
 * variant="nav"     -> compact, inherits colour from nav state where needed
 * variant="display" -> large stacked mark for hero / brand moments
 */
export interface Props {
  variant?: "nav" | "display";
  class?: string;
}
const { variant = "nav", class: className = "" } = Astro.props;
---

{
  variant === "display" ? (
    <span class:list={["inline-flex flex-col leading-none", className]}>
      <span class="field-label text-slate">Distributed AI</span>
      <span class="mt-2 font-display text-5xl font-bold tracking-tight">
        <span style="color: var(--color-orange);">DAI</span>
        <span class="text-snow"> Compute</span>
      </span>
    </span>
  ) : (
    <span
      class:list={[
        "brand-text inline-flex items-baseline gap-1.5 font-display font-semibold tracking-tight",
        className,
      ]}
    >
      <span style="color: var(--color-orange);">DAI</span>
      <span>Compute</span>
    </span>
  )
}
