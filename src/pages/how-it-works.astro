---
import Main from "@/layouts/Main.astro";
import PageHeader from "@/components/PageHeader.astro";
import TokenCard from "@/components/TokenCard.astro";
import StepCard from "@/components/StepCard.astro";
import Placeholder from "@/components/Placeholder.astro";

const compare = [
  { dim: "Model", alliance: "Centralised public supercomputer", dai: "Distributed community network" },
  { dim: "Users", alliance: "24,000 academic researchers", dai: "Industry, startups, citizens" },
  { dim: "Capital", alliance: "100% public ($705M)", dai: "Private capital alongside public" },
  { dim: "Access", alliance: "Peer-review allocation", dai: "Contribution or purchase" },
  { dim: "Energy", alliance: "Grid-powered", dai: "Linked to distributed generation" },
  { dim: "Scale driver", alliance: "Budget cycles", dai: "Market demand + network effects" },
];
---

<Main
  title="How It Works - Asset-backed compute, burned on use"
  description="DAI Compute connects Canadian energy to Canadian compute through a dual-token protocol. Asset-backed, community-operated, burned on use. Complementary to the federal SCIP programme."
  activePath="/how-it-works"
>
  <PageHeader
    eyebrow="How it works"
    title="The economic mechanism that connects Canadian energy to compute."
    lede="A homeowner installs solar panels and a compute node. Their system generates energy and provides AI processing beyond home use. They earn tokens backed by physical Canadian infrastructure. The blockchain is the accounting layer that makes every contribution verifiable."
  />

  <!-- The three-step mechanism -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <p class="field-label" style="color: var(--color-spruce);">The mechanism</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight">
      Lead with the outcome. The blockchain is the accounting, not the headline.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <StepCard index="01" title="Generate and provide">
        A node operator&rsquo;s rooftop solar and compute node produce energy
        and AI processing in abundance of home use. This is productive labour,
        not passive holding.
      </StepCard>
      <StepCard index="02" title="Earn asset-backed tokens">
        The system earns tokens backed by physical Canadian infrastructure.
        The critical unlock is financing: the solar-lease model, which built a
        $50B industry, extended to compute hardware at zero down.
      </StepCard>
      <StepCard index="03" title="Verify every contribution">
        The blockchain records every contribution so any member can verify that
        their participation funded real Canadian hardware. Solar-powered
        compute is a renewable resource for carbon-aware computing.
      </StepCard>
    </div>
  </section>

  <!-- Dual token full spec -->
  <section class="border-y border-hairline bg-parchment-2/40">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <div class="max-w-3xl">
        <p class="field-label" style="color: var(--color-spruce);">The dual-token design</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight">
          Asset-backed and burned on use. Two phrases that distance this from speculation.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-graphite">
          Both tokens enter circulation through productive activity and exit
          through consumption. This is Burn-Mint Equilibrium: no inflation, no
          deflation, no yield from holding. Tokens depreciate if not used, so
          the design makes hoarding economically irrational.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <TokenCard
          symbol="NRG"
          name="Energy credit"
          tagline="Represents verified Canadian renewable energy generation."
          attributes={[
            { k: "Minting", v: "Smart-meter oracle attestation" },
            { k: "Burning", v: "Energy use or AMM exchange for CMP" },
            { k: "Supply", v: "Grows with real generation" },
            { k: "Oracle", v: "Smart-meter data + attestation" },
            { k: "Class", v: "Utility (consumptive)" },
          ]}
        />
        <TokenCard
          symbol="CMP"
          name="Compute credit"
          tagline="Represents verified Canadian compute capacity provision."
          attributes={[
            { k: "Minting", v: "Staked GPU/CPU (proof-of-compute)" },
            { k: "Burning", v: "Enterprise compute access" },
            { k: "Supply", v: "Grows with verified provision" },
            { k: "Oracle", v: "Benchmark + uptime monitoring" },
            { k: "Class", v: "Utility (consumptive)" },
          ]}
        />
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="border border-hairline bg-parchment p-7">
          <p class="field-label text-graphite">Exchange</p>
          <h3 class="mt-2 font-display text-lg font-semibold">NRG / CMP AMM pool</h3>
          <p class="mt-3 text-sm leading-relaxed text-graphite">
            An automated market maker sets a market-driven exchange rate that
            reflects the relative supply and demand of energy versus compute.
            Supply is algorithmic; exchange rates are market-driven.
          </p>
        </div>
        <div class="border border-hairline bg-parchment p-7">
          <p class="field-label text-graphite">Chain</p>
          <h3 class="mt-2 font-display text-lg font-semibold">EVM Layer 2</h3>
          <p class="mt-3 text-sm leading-relaxed text-graphite">
            The protocol deploys on an EVM Layer 2 chain for low-cost, verifiable
            settlement. Governance (future) uses a vote-escrow model over protocol
            parameters, never over token supply or exchange rates.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Node economics -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="field-label" style="color: var(--color-spruce);">Node operator economics</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight">
          Zero down. Cash-flow positive from month one after the loan payment.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-graphite">
          Financing extends the proven solar-lease collateral model to include
          compute hardware. The hardware is physical, retainable, and
          resellable; energy credits provide predictable cash-flow coverage.
        </p>
        <div class="mt-8 border-l-2 pl-6" style="border-color: var(--color-spruce);">
          <p class="field-note text-graphite">Illustrative residential node</p>
          <p class="mt-2 text-sm leading-relaxed text-graphite">
            Monthly revenue of roughly $280-$750 from net metering, NRG, and CMP
            earnings, against a financing payment of $200-$500, breaks even in
            18-24 months with financing. Figures are conservative modelling
            estimates, not guaranteed returns.
          </p>
        </div>
      </div>
      <div>
        <Placeholder
          kind="data"
          ratio="4/3"
          label="Node revenue and break-even model"
          note="Sourcing brief: stacked-bar or waterfall chart of monthly node revenue streams (net metering, NRG, CMP) minus financing payment, with break-even marker at 18-24 months. Full model in indicators-strategy/strategy.md. Label clearly as illustrative."
        />
      </div>
    </div>
  </section>

  <!-- Complement not compete -->
  <section class="border-t border-hairline bg-parchment-2/40">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="field-label" style="color: var(--color-spruce);">Positioning</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight">
        We complement the government&rsquo;s programme. We do not replace it.
      </h2>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-graphite">
        One supercomputer for frontier academic research. One distributed
        network for the 140,000 professionals, startups, and citizens who are
        currently excluded. Both are needed.
      </p>
      <div class="mt-10 overflow-x-auto border border-hairline bg-parchment">
        <table class="w-full min-w-[640px] text-sm">
          <thead>
            <tr class="border-b border-hairline text-left">
              <th class="p-4 font-medium"></th>
              <th class="p-4 font-medium text-graphite">Alliance proposal (SCIP)</th>
              <th class="p-4 font-medium" style="color: var(--color-spruce);">DAI Compute</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((r) => (
                <tr class="border-b border-hairline/60">
                  <td class="field-note p-4 align-top text-graphite">{r.dim}</td>
                  <td class="p-4 align-top text-graphite">{r.alliance}</td>
                  <td class="p-4 align-top font-medium text-ink">{r.dai}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-6 py-16 text-center lg:px-10">
    <h2 class="mx-auto max-w-2xl font-display text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
      Ready to see how you would participate?
    </h2>
    <a
      href="/participate"
      class="mt-8 inline-flex items-center px-7 py-3.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
      style="background-color: var(--color-spruce);"
    >
      Ways to participate
    </a>
  </section>
</Main>
