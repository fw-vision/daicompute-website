---
import Main from "@/layouts/Main.astro";
import PageHeader from "@/components/PageHeader.astro";
import StepCard from "@/components/StepCard.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import Placeholder from "@/components/Placeholder.astro";
---

<Main
  title="Build - Non-recourse financing for Canadian energy and compute"
  description="Borrow against the Canadian energy and compute infrastructure you build. Non-recourse loans secured by physical assets and their cashflows. Zero-down operator paths and institutional facilities."
  activePath="/build"
>
  <PageHeader
    eyebrow="Build"
    title="Borrow against the infrastructure you build."
    lede="Non-recourse financing for Canadian energy and compute hardware, secured by the physical assets and the cashflows they generate. From a homeowner financing a node at zero down to an energy company financing a data hall."
  />

  <!-- Loan lifecycle -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <p class="field-label" style="color: var(--color-yellow);">How financing works</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
      Structured like equipment finance. Secured by real assets.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <StepCard index="01" title="Apply against your assets">
        Node operators, energy companies, and data-centre developers apply for
        financing to acquire Canadian energy and compute hardware, solar,
        batteries, and GPU nodes.
      </StepCard>
      <StepCard index="02" title="Non-recourse, asset-secured">
        Loans are secured by the physical assets and their contracted
        cashflows. Recourse is limited to the collateral, with springing
        recourse to the operating entity for fraud.
      </StepCard>
      <StepCard index="03" title="Draw, build, repay">
        Funds release against verified delivery and installation. You build,
        generate energy and compute, and repay on a standard amortising
        schedule.
      </StepCard>
    </div>
  </section>

  <!-- Who borrows -->
  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="field-label" style="color: var(--color-yellow);">Who borrows</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
        From a rooftop to a data hall.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <FeatureCard kicker="Node operator" title="Zero down" accent="yellow">
          Finance solar plus a compute node at zero down, extending the proven
          solar-lease model to compute. Your earnings service the loan; after
          the term, you own the hardware.
        </FeatureCard>
        <FeatureCard kicker="Energy company" title="Higher-value load" accent="yellow">
          Co-locate compute with generation and earn several times the value per
          MWh of selling electrons wholesale. A Build-to-Manage path from
          commodity producer to energy-and-compute provider.
        </FeatureCard>
        <FeatureCard kicker="Data-centre developer" title="Institutional facilities" accent="yellow">
          Non-recourse facilities structured to institutional scale, secured by
          the hardware and offtake cashflows, on Canadian soil under Canadian
          law.
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Hybrid legal structure -->
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="field-label" style="color: var(--color-yellow);">The structure</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
          Real-world enforceable. On-chain transparent.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-slate">
          Financing runs across two synchronised layers. Off-chain gives lenders
          real rights: an isolated legal entity, registered security interests
          under Canadian personal-property law, escrow at a Canadian trust
          company, and control agreements on collection accounts. On-chain gives
          transparency and automation: loan NFTs, an authoritative lender
          register, and an automated payment waterfall.
        </p>
        <ul class="mt-6 space-y-3 text-sm leading-relaxed text-slate">
          <li class="flex gap-3"><span aria-hidden="true" style="color: var(--color-yellow);">&mdash;</span> Bankruptcy-remote SPV isolates the collateral.</li>
          <li class="flex gap-3"><span aria-hidden="true" style="color: var(--color-yellow);">&mdash;</span> PPSA registrations perfect the security interest.</li>
          <li class="flex gap-3"><span aria-hidden="true" style="color: var(--color-yellow);">&mdash;</span> A debt-service reserve, held in CADS, compresses your rate.</li>
        </ul>
      </div>
      <Placeholder
        kind="data"
        ratio="4/3"
        label="On-chain / off-chain loan lifecycle diagram"
        note="Sourcing brief: the four-phase loan flow (escrow, delivery, install/verify + lien, release/repay) across the on-chain and off-chain layers. Adapted from USD.AI to Canadian PPSA + SPV. See brand-guidelines/tokenomics.md and landscape/regulatory-notes.md. Cursor / dataviz handoff."
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <div class="max-w-3xl border-l-2 pl-6" style="border-color: var(--color-yellow);">
        <p class="field-label text-slate">Where we are</p>
        <p class="mt-3 text-sm leading-relaxed text-slate">
          The borrower facility is in design, pending regulatory clarity and the
          first financing partnerships. Our near-term goal is a first cohort of
          pilot nodes: real hardware, real generation, real compute. Register
          your interest to build with us.
        </p>
        <a href="/contact" class="mt-6 inline-flex items-center px-7 py-3.5 text-sm font-medium" style="background: var(--color-yellow); color: var(--color-ink);">
          Register to build
        </a>
      </div>
    </div>
  </section>
</Main>
